{
  "schema_version": 1,
  "orientation": {
    "rules_source": "AGENTS.md",
    "file_tree": "FILE-TREE.html",
    "operating_map": "PROJECT-OS.html",
    "nearest_rules_win": true
  },
  "layout": {
    "axis": "domain-first",
    "generated_code": "isolated",
    "public_surfaces": "explicit"
  },
  "operations": {
    "root": "script",
    "entrypoints": ["bootstrap", "setup", "test", "server", "update"]
  },
  "required_paths": [
    "AGENTS.md",
    "PROJECT-OS.html",
    "FILE-TREE.html",
    ".project-os/project.json",
    ".agents/tasks",
    "docs/project-os/ONBOARDING.html",
    ".uihub/README.html"
  ],
  "ratchet": {
    "baseline": ".project-os/architecture/baseline.json",
    "policy": "non-regression",
    "metric_retirement_requires_decision": true
  }
}
