{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/sprint.schema.json",
  "title": "SISO Project OS Sprint",
  "description": "Canonical coordination state for a time-bounded group of existing tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "objective",
    "status",
    "base_ref",
    "created_at",
    "created_by",
    "task_ids",
    "waves",
    "lanes",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/sprintId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["planned", "active", "blocked", "completed", "cancelled"]
    },
    "base_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskId"
      }
    },
    "waves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wave"
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "since"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "requires": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed_at", "closed_by", "summary", "run_ids", "archive_path"],
      "properties": {
        "closed_at": {
          "type": "string",
          "format": "date-time"
        },
        "closed_by": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "run_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/runId"
          }
        },
        "archive_path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["started_at"],
        "properties": {
          "base_ref": {
            "type": "string",
            "minLength": 1
          },
          "task_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["blocker"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["completed", "cancelled"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["closeout"]
      }
    }
  ],
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "sprintId": {
      "type": "string",
      "pattern": "^SPRINT-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$"
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lane_ids", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "lane_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "task_ids",
        "write_fence",
        "depends_on",
        "packet_path",
        "state_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taskId"
          }
        },
        "write_fence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packet_path": {
          "type": "string",
          "minLength": 1
        },
        "state_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "required", "status", "evidence_refs"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "waived"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
