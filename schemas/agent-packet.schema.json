{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/agent-packet.schema.json",
  "title": "SISO Project OS Agent Packet",
  "description": "Immutable, run-scoped execution contract for one agent or lane.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "to",
    "from",
    "thread",
    "objective",
    "state",
    "mode",
    "task_ids",
    "run_id",
    "anchors",
    "facts",
    "decisions",
    "constraints",
    "actions",
    "verification",
    "open_questions",
    "write_fence",
    "return_contract",
    "stop_conditions",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^PACKET-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "to": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "thread": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": ["new", "ready", "working", "blocked", "complete", "failed", "cancelled"]
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskId"
      }
    },
    "sprint_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/sprintId"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationCheck"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedStatement"
      }
    },
    "write_fence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "format", "required_fields", "final_verdict"],
      "properties": {
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": ["json", "markdown", "jsonl"]
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1
        },
        "final_verdict": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "amends": {
      "type": "string",
      "pattern": "^PACKET-[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "sprintId": {
      "type": "string",
      "pattern": "^SPRINT-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "description", "required"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "namedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "blocked", "skipped"]
        }
      }
    },
    "verificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
