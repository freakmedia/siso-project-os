{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/run.schema.json",
  "title": "SISO Project OS Run",
  "description": "Canonical state for one immutable execution attempt over existing tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "objective",
    "status",
    "base_ref",
    "created_at",
    "created_by",
    "task_ids",
    "constraints",
    "units",
    "packets",
    "receipts",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/runId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["planned", "running", "blocked", "completed", "failed", "cancelled"]
    },
    "base_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "branch": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "worktree": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "sprint_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/sprintId"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskId"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "packets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "since"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "requires": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed_at", "closed_by", "verdict", "summary", "outputs"],
      "properties": {
        "closed_at": {
          "type": "string",
          "format": "date-time"
        },
        "closed_by": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": ["passed", "failed", "cancelled"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputDisposition"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["started_at"],
        "properties": {
          "base_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["blocker"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["completed", "failed", "cancelled"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["closeout"]
      }
    }
  ],
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "sprintId": {
      "type": "string",
      "pattern": "^SPRINT-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "task_ids",
        "status",
        "depends_on",
        "packet_path",
        "write_fence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taskId"
          }
        },
        "status": {
          "type": "string",
          "enum": ["ready", "assigned", "running", "returned", "landed", "blocked", "failed", "cancelled"]
        },
        "assignee": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packet_path": {
          "type": "string",
          "minLength": 1
        },
        "return_path": {
          "type": "string",
          "minLength": 1
        },
        "write_fence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "kind", "ref", "description"],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "enum": ["command", "commit", "artifact", "observation", "return", "landing"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "required", "status", "evidence_refs"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "waived"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outputDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "classification", "rationale"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "task_evidence",
            "durable_doc",
            "decision",
            "memory",
            "raw_run_history",
            "scratch"
          ]
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
