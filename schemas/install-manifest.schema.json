{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/install-manifest.schema.json",
  "title": "Project OS install manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "installed_version", "installed_at", "installed_by", "files", "preserved_paths"],
  "properties": {
    "schema_version": { "const": 1 },
    "package": { "const": "@siso/project-os" },
    "installed_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "installed_at": { "type": "string", "format": "date-time" },
    "installed_by": { "type": "string", "minLength": 1, "maxLength": 160 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "preserved_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
